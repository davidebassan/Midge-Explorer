<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>midge_bringup</name>
  <version>2.0.0</version>
  <description>Midge robot model, Gazebo world, SLAM/Nav2 configuration and launch files</description>
  <maintainer email="d.bassan@hotmail.it">davidebassan</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>midge</exec_depend>
  <exec_depend>midge_web</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
